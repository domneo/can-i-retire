{
  "name": "can-i-retire",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env.local src/serve.ts",
    "start": "node --env-file-if-exists=.env.local dist/serve.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "scrape": "tsx --env-file-if-exists=.env.local src/jobs/scrape.ts",
    "migrate": "tsx --env-file-if-exists=.env.local src/db/migrate-cli.ts",
    "backfill": "tsx --env-file-if-exists=.env.local src/jobs/backfill.ts",
    "webhook": "tsx --env-file-if-exists=.env.local src/bot/set-webhook.ts",
    "test": "tsx --test \"src/**/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "^24.5.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@hono/zod-openapi": "^1.6.3",
    "@libsql/client": "^0.18.0",
    "@vercel/blob": "^2.8.0",
    "cheerio": "^1.2.0",
    "grammy": "^1.46.0",
    "hono": "^4.13.7",
    "zod": "^4.6.5"
  }
}
