# Copy to .env and fill in. Required before any scrape run.
# Published in the scraper's User-Agent so sgpools can reach a human.
SGPOOLS_CONTACT=

# Optional. Set both to use Turso instead of the local file.
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=

# Optional overrides.
# SGPOOLS_DB=data/data.db
# PORT=3000

# Optional. Archive raw pages to Vercel Blob instead of data/raw/.
# BLOB_READ_WRITE_TOKEN=

# Deployed only. The bearer token /cron/scrape requires.
# CRON_SECRET=

# Optional. Scrape runs report to this chat; unset means no send at all.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
