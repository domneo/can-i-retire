# The deployed setup: run `vercel env pull .env.local`, which writes every
# variable below that Vercel holds. For a local-only setup, copy this file to
# .env.local and fill in SGPOOLS_CONTACT; leave the rest commented out, since
# an empty value is not the same as an unset one.
#
# Keys are in the order `vercel env pull` writes them.

# Optional. Archive raw pages to Vercel Blob instead of data/raw/.
# BLOB_READ_WRITE_TOKEN=

# Deployed only, so `vercel env pull` leaves it out. The bearer token
# /cron/scrape requires.
# CRON_SECRET=

# Optional. The local server's port.
# PORT=3000

# Required before any scrape run. Published in the scraper's User-Agent so
# sgpools can reach a human.
SGPOOLS_CONTACT=

# Optional. The local SQLite file, used only while TURSO_DATABASE_URL is unset.
# SGPOOLS_DB=data/data.db

# Optional. Scrape runs report to this chat; unset means no send at all.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Required for the bot. The secret Telegram sends with every webhook update;
# /telegram/webhook refuses all updates while it is unset. Any 1-256 chars of
# A-Z a-z 0-9 _ -, e.g. from `openssl rand -hex 32`.
# TELEGRAM_WEBHOOK_SECRET=

# Optional. Set both to use Turso instead of the local file.
# TURSO_AUTH_TOKEN=
# TURSO_DATABASE_URL=

# Written by `vercel env pull`. Nothing in this project reads it.
# VERCEL_OIDC_TOKEN=
